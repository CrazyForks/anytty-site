---
import { ArrowLeft, ArrowRight } from 'lucide-react'

import DocsTree from '@/components/docs/DocsTree.astro'
import { DocsDrawer } from '@/components/docs/DocsDrawer'
import { buttonVariants } from '@/components/ui/button'
import BaseLayout from './BaseLayout.astro'
import { docTree, docTrail, docs, localizedPath, sitePath, type Locale } from '@/lib/site'
import { cn } from '@/lib/utils'

interface Props { locale: Locale; slug: string; title: string; description: string; headings?: { depth: number; slug: string; text: string }[] }
const { locale, slug, title, description, headings = [] } = Astro.props
const pathname = localizedPath(locale, `/docs/${slug}`)
const activeIndex = docs.findIndex(([path]) => path === slug)
const previous = activeIndex > 0 ? docs[activeIndex - 1] : undefined
const next = activeIndex >= 0 && activeIndex < docs.length - 1 ? docs[activeIndex + 1] : undefined
const labels = locale === 'en'
  ? { directory: 'Documentation', menu: 'Open documentation menu', close: 'Close documentation menu', previous: 'Previous', next: 'Next', description: 'Choose a guide to continue.' }
  : { directory: '文档目录', menu: '打开文档目录', close: '关闭文档目录', previous: '上一篇', next: '下一篇', description: '选择一个主题继续阅读。' }
const trail = docTrail(slug)
const proseClass = cn(
  'docs-prose prose prose-neutral min-w-0 max-w-3xl',
  'prose-headings:scroll-mt-28 prose-headings:font-medium prose-headings:tracking-normal prose-headings:text-foreground',
  'prose-h1:mb-7 prose-h1:text-3xl prose-h1:leading-tight sm:prose-h1:text-4xl',
  'prose-h2:mb-4 prose-h2:mt-12 prose-h2:text-xl prose-h2:leading-snug',
  'prose-h3:mb-3 prose-h3:mt-9 prose-h3:text-base',
  'prose-p:text-base prose-p:font-normal prose-p:leading-7 prose-p:text-muted-foreground',
  'prose-li:text-base prose-li:leading-7 prose-li:text-muted-foreground',
  'prose-strong:font-medium prose-strong:text-foreground',
  'prose-a:font-normal prose-a:text-primary prose-a:underline-offset-4 hover:prose-a:text-primary/80',
  'prose-code:font-mono prose-code:text-[13px] prose-code:font-normal prose-code:text-foreground prose-code:before:content-none prose-code:after:content-none',
  'prose-pre:overflow-x-auto prose-pre:rounded-lg prose-pre:bg-zinc-950 prose-pre:text-zinc-100 prose-pre:shadow-sm',
  'prose-table:block prose-table:max-w-full prose-table:overflow-x-auto',
  'prose-blockquote:rounded-r-lg prose-blockquote:border-primary prose-blockquote:bg-secondary/50 prose-blockquote:px-5 prose-blockquote:py-1 prose-blockquote:font-normal prose-blockquote:not-italic',
  'prose-img:rounded-lg prose-img:shadow-sm',
  'prose-hr:border-border/60',
)
---

<BaseLayout locale={locale} title={title} description={description} pathname={pathname}>
  <main id="main" class="mx-auto min-h-[calc(100vh-8rem)] max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
    <DocsDrawer client:load title={labels.directory} label={labels.menu} closeLabel={labels.close} description={labels.description}>
      <DocsTree nodes={docTree} locale={locale} current={slug} />
    </DocsDrawer>
    <div class="grid items-start gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
      <aside class="sticky top-24 hidden max-h-[calc(100dvh-7rem)] overflow-y-auto pb-8 lg:block">
        <nav aria-label={labels.directory}><DocsTree nodes={docTree} locale={locale} current={slug} /></nav>
      </aside>
      <article class={proseClass}>
        <nav class="not-prose mb-7 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground" aria-label={locale === 'en' ? 'Breadcrumb' : '当前位置'}>
          <a class="hover:text-foreground" href={sitePath(localizedPath(locale, '/docs/overview'))}>{labels.directory}</a>
          {trail.map(node => <><span aria-hidden="true">/</span><span>{locale === 'en' ? node.en : node.zh}</span></>)}
        </nav>
        {headings.filter(h => h.depth === 2).length > 2 && <details class="not-prose mb-8 rounded-lg border border-border px-4 py-2">
          <summary class="min-h-11 cursor-pointer py-3 text-sm font-medium">{locale === 'en' ? 'On this page' : '本页内容'}</summary>
          <ul class="mb-3 grid list-none gap-1 p-0 sm:grid-cols-2">
            {headings.filter(h => h.depth === 2).map(h => <li><a class="block rounded px-2 py-2 text-sm text-muted-foreground hover:bg-secondary hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary" href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </details>}
        <slot />
        <nav class="not-prose mt-14 grid gap-3 sm:grid-cols-2" aria-label={locale === 'en' ? 'Documentation pagination' : '文档翻页'}>
          {previous ? (
            <a class={cn(buttonVariants({ variant: 'outline' }), 'h-auto min-h-16 whitespace-normal justify-start gap-3 px-4 py-3 text-left font-normal')} href={sitePath(localizedPath(locale, `/docs/${previous[0]}`))}>
              <ArrowLeft className="size-4 shrink-0" aria-hidden="true" />
              <span><span class="block text-xs text-muted-foreground">{labels.previous}</span><span class="mt-1 block text-sm">{locale === 'en' ? previous[1] : previous[2]}</span></span>
            </a>
          ) : <span aria-hidden="true"></span>}
          {next && (
            <a class={cn(buttonVariants({ variant: 'outline' }), 'h-auto min-h-16 whitespace-normal justify-between gap-3 px-4 py-3 text-left font-normal')} href={sitePath(localizedPath(locale, `/docs/${next[0]}`))}>
              <span><span class="block text-xs text-muted-foreground">{labels.next}</span><span class="mt-1 block text-sm">{locale === 'en' ? next[1] : next[2]}</span></span>
              <ArrowRight className="size-4 shrink-0" aria-hidden="true" />
            </a>
          )}
        </nav>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .docs-prose :global(p code), .docs-prose :global(li code) { overflow-wrap: anywhere; }
</style>
