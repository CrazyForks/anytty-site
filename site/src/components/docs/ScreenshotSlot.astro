---
import briefs from '@/lib/doc-screenshots.json';
import type { Locale } from '@/lib/site';
interface Props { id: keyof typeof briefs; locale: Locale }
const { id, locale } = Astro.props;
const brief = briefs[id][locale === 'en' ? 'en' : 'zh'];
---
<figure data-screenshot-id={id} class="not-prose my-8 rounded-xl border border-dashed border-border bg-secondary/30 p-5 sm:p-6">
  <figcaption class="text-sm font-medium text-foreground">{locale === 'en' ? 'Screenshot to add' : '待补截图'} · {brief.title}</figcaption>
  <p class="mt-2 text-sm leading-6 text-muted-foreground">{brief.purpose}</p>
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-primary focus-visible:outline-2">{locale === 'en' ? 'Capture instructions' : '截图要求'} · {id}</summary>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">{brief.scene}</p>
  </details>
</figure>
