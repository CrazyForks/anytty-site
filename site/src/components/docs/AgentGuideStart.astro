---
import { agentGuideUrl, agentGuideGitHubUrl } from '@/lib/agent-guide';
import { buttonVariants } from '@/components/ui/button';
import type { Locale } from '@/lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const prompt = zh
  ? `请先阅读 AnyTTY 的使用指南：\n${agentGuideUrl}\n\n然后帮我解决这个问题：［填写你的问题］`
  : `Read the AnyTTY guide first:\n${agentGuideUrl}\n\nThen help me with this question: [your question]`;
---
<section data-agent-guide class="not-prose my-5 rounded-xl border border-border bg-secondary/30 p-5 sm:p-6"
  data-copied={zh ? '已复制，可以粘贴给你的 Agent。' : 'Copied. Paste it into your agent.'}
  data-fallback={zh ? '请手动复制已选中的文字。' : 'Copy the selected text manually.'}>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-sm">
    <span class="font-medium text-foreground">{zh ? '复制这段话，发给你的 Agent' : 'Copy this message to your agent'}</span>
    <a href={agentGuideGitHubUrl} class="text-primary underline underline-offset-4">{zh ? '在 GitHub 查看 llm.txt' : 'View llm.txt on GitHub'}</a>
  </div>
  <label for={`agent-prompt-${locale}`} class="sr-only">{zh ? '发送给 Agent 的内容' : 'Message for your agent'}</label>
  <textarea id={`agent-prompt-${locale}`} data-agent-prompt readonly rows={5} spellcheck="false"
    class="block min-h-52 w-full sm:min-h-40 resize-y rounded-lg border border-border bg-background p-3 font-mono text-sm leading-6 text-foreground focus-visible:outline-2 focus-visible:outline-primary">{prompt}</textarea>
  <div class="mt-4 flex flex-wrap items-center gap-4">
    <button type="button" data-agent-copy class={`${buttonVariants({size:'lg'})} min-h-11`}>{zh ? '复制给 Agent' : 'Copy for your agent'}</button>
    <a href={agentGuideUrl} class="text-sm text-primary underline underline-offset-4">{zh ? '打开纯文本' : 'Open plain text'}</a>
  </div>
  <p data-agent-status role="status" aria-live="polite" class="mt-3 text-sm leading-6 text-muted-foreground"></p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-agent-guide]').forEach(card => {
    const input = card.querySelector<HTMLTextAreaElement>('[data-agent-prompt]');
    const button = card.querySelector<HTMLButtonElement>('[data-agent-copy]');
    const status = card.querySelector<HTMLElement>('[data-agent-status]');
    if (!input || !button || !status) return;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        status.textContent = card.dataset.copied ?? '';
      } catch {
        input.focus();
        input.select();
        status.textContent = card.dataset.fallback ?? '';
      }
    });
  });
</script>
