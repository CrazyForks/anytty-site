---
import CloudLandingPage from '@/components/cloud-landing-page.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { brandSlogan } from '@/lib/brand'

const description = brandSlogan
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AnyTTY Cloud',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows, Android, iOS',
  description,
  offers: [
    { '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Lite 月付', price: '9.90', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'PRO 月付', price: '19.90', priceCurrency: 'USD' },
  ],
}
---

<BaseLayout locale="zh-CN" title="Cloud" description={description} pathname="/zh-CN/cloud/">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <CloudLandingPage locale="zh-CN" />
</BaseLayout>
